# Скопируйте этот файл в .env и подставьте свой ключ.
# Ключ используется ТОЛЬКО на сервере и никогда не отдаётся клиенту.
OPENAI_API_KEY=sk-replace-me

# (необязательно) Базовый URL OpenAI-совместимого API. По умолчанию api.openai.com.
# OPENAI_BASE_URL=https://api.openai.com/v1

# (необязательно) Максимальный размер загружаемого файла в МБ (по умолчанию 50).
# MAX_UPLOAD_MB=50

# (необязательно) Таймаут загрузки внешнего URL в мс (по умолчанию 10000).
# URL_FETCH_TIMEOUT_MS=10000

# (необязательно) Лимит извлечённого из URL текста в символах (по умолчанию 8000).
# URL_TEXT_LIMIT=8000
