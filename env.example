:root {
  --bg: #f7f6f2;
  --card: #ffffff;
  --ink: #1a1a1a;
  --ink-soft: #555;
  --line: #e3e1da;
  --accent: #2b5d3a;
  --accent-soft: #e6efe6;
  --error: #b13a2e;
  --error-soft: #faeae6;
  --warn: #8a6a1a;
  --warn-soft: #f6efd9;
  --ok: #2b5d3a;
  --ok-soft: #e6efe6;
  --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
  --serif: "Georgia", "Cambria", "Times New Roman", serif;
  --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Arial, sans-serif;
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: var(--sans);
  font-size: 15px;
  line-height: 1.5;
}

a {
  color: var(--accent);
}

.app {
  max-width: 980px;
  margin: 0 auto;
  padding: 32px 24px 96px;
}

.header {
  border-bottom: 1px solid var(--line);
  padding-bottom: 16px;
  margin-bottom: 28px;
}

.header h1 {
  font-family: var(--serif);
  font-weight: 600;
  font-size: 28px;
  margin: 0 0 4px;
  letter-spacing: -0.01em;
}

.header p {
  color: var(--ink-soft);
  margin: 0;
  font-size: 14px;
}

.card {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 20px 22px;
  margin-bottom: 20px;
}

.card h2 {
  font-family: var(--serif);
  font-weight: 600;
  font-size: 18px;
  margin: 0 0 14px;
  letter-spacing: -0.005em;
}

.card .subtle {
  color: var(--ink-soft);
  font-size: 13px;
  margin: 0 0 12px;
}

.row {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  align-items: center;
}

label {
  display: block;
  font-size: 13px;
  color: var(--ink-soft);
  margin-bottom: 6px;
}

input[type="file"],
input[type="number"],
select {
  font: inherit;
  padding: 8px 10px;
  border: 1px solid var(--line);
  border-radius: 6px;
  background: #fff;
  color: var(--ink);
}

input[type="number"] {
  width: 120px;
}

select {
  min-width: 200px;
}

button {
  font: inherit;
  font-weight: 500;
  padding: 9px 16px;
  border-radius: 6px;
  border: 1px solid var(--line);
  background: #fff;
  color: var(--ink);
  cursor: pointer;
  transition: background 0.12s ease, border-color 0.12s ease;
}

button:hover:not(:disabled) {
  background: #f0eee8;
}

button.primary {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
}

button.primary:hover:not(:disabled) {
  background: #234a2f;
}

button.danger {
  background: #fff;
  color: var(--error);
  border-color: var(--error);
}

button.danger:hover:not(:disabled) {
  background: var(--error-soft);
}

button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.checkbox-list {
  display: flex;
  flex-direction: column;
  gap: 4px;
  max-height: 280px;
  overflow-y: auto;
  border: 1px solid var(--line);
  border-radius: 6px;
  padding: 8px 10px;
  background: #fbfaf6;
  font-size: 13px;
}

.checkbox-list label {
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  margin: 0;
  padding: 3px 4px;
  border-radius: 4px;
  color: var(--ink);
}

.checkbox-list label:hover {
  background: #f0eee8;
}

.checkbox-list input[type="checkbox"] {
  margin: 0;
}

.tag {
  display: inline-block;
  background: var(--accent-soft);
  color: var(--accent);
  border-radius: 4px;
  padding: 2px 8px;
  font-size: 12px;
  font-family: var(--mono);
  margin-right: 6px;
}

.tag.muted {
  background: #f0eee8;
  color: var(--ink-soft);
}

.alert {
  padding: 12px 14px;
  border-radius: 6px;
  font-size: 14px;
  margin: 8px 0;
  border: 1px solid;
}

.alert.error {
  background: var(--error-soft);
  border-color: #e3c2bc;
  color: var(--error);
}

.alert.warn {
  background: var(--warn-soft);
  border-color: #e3d3a3;
  color: var(--warn);
}

.alert.ok {
  background: var(--ok-soft);
  border-color: #c4d6c4;
  color: var(--ok);
}

.progress-bar {
  height: 6px;
  background: var(--line);
  border-radius: 3px;
  overflow: hidden;
  margin: 10px 0;
}

.progress-bar-fill {
  height: 100%;
  background: var(--accent);
  transition: width 0.2s ease;
}

.progress-stats {
  display: flex;
  gap: 18px;
  font-size: 13px;
  color: var(--ink-soft);
}

.progress-stats strong {
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

.log {
  font-family: var(--mono);
  font-size: 12px;
  background: #1a1a1a;
  color: #e6e6e6;
  border-radius: 6px;
  padding: 12px;
  height: 260px;
  overflow-y: auto;
  white-space: pre-wrap;
  word-break: break-word;
  margin-top: 12px;
}

.log .ok {
  color: #8ad08a;
}

.log .err {
  color: #e58a7e;
}

.log .skip {
  color: #c8b878;
}

.log .info {
  color: #9ec6e8;
}

.controls {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 14px;
}

.cols-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

@media (max-width: 720px) {
  .cols-grid {
    grid-template-columns: 1fr;
  }
}

.detected-badges {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  margin: 6px 0 14px;
  font-size: 13px;
}

.detected-badges b {
  color: var(--ink-soft);
  font-weight: 500;
}
